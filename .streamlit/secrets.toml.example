# Streamlit Secrets Configuration Example
# Copy this file to secrets.toml and add your actual API keys
# DO NOT commit the actual secrets.toml file to version control

# OpenAI Configuration (Recommended)
OPENAI_API_KEY = "sk-your-openai-api-key-here"
OPENAI_MODEL = "gpt-4o-mini"

# Alternative: Anthropic Configuration
# ANTHROPIC_API_KEY = "sk-ant-your-anthropic-api-key-here"
# ANTHROPIC_MODEL = "claude-3-5-haiku"

# RAG Configuration
RAG_MAX_TOKENS = 300
RAG_TEMPERATURE = 0.1
RAG_TOP_K = 5
RAG_SIMILARITY_THRESHOLD = 0.4

# Logging Configuration
LOG_LEVEL = "INFO"
LOG_FILE = "logs/streamlit_app.log"

# Optional: Email for notifications
# EMAIL_SENDER = "your-email@gmail.com"
# EMAIL_PASSWORD = "your-app-password"
# EMAIL_RECIPIENTS = ["admin@example.com"]
